# Create a Telegram bot with BotFather. Never commit the real token.
BOT_TOKEN=123456789:replace_with_real_token
# At least 32 random characters. Use a password manager / secure generator.
WEBHOOK_SECRET=replace_with_32_or_more_random_characters
# Render PostgreSQL Internal URL or local Docker URL.
DATABASE_URL=postgresql+asyncpg://pulse:password@localhost:5432/pulse
BOT_MODE=webhook
WEBHOOK_BASE_URL=https://your-service.onrender.com
LOG_LEVEL=INFO
WS_TOKEN_TTL=60
MAX_FILE_BYTES=20971520
